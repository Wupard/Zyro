let currentUser = null;
let currentPage = 'dashboard';
function getDefaultWorkoutTab() {
  const day = new Date().getDay(); // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  if (day === 2) return 'day1'; // SalÄ± (Push)
  if (day === 3) return 'day2'; // Ã‡arÅŸamba (Pull)
  if (day === 4) return 'day3'; // PerÅŸembe (dinlenme) -> SÄ±radaki Cuma (day3)
  if (day === 5) return 'day3'; // Cuma (Bacak + Core)
  if (day === 6) return 'day4'; // Cumartesi (Ãœst VÃ¼cut)
  if (day === 0) return 'day5'; // Pazar (Alt VÃ¼cut + Core)
  if (day === 1) return 'day1'; // Pazartesi (dinlenme) -> SÄ±radaki SalÄ± (day1)
  return 'day1';
}
