  if (!db) return;
  try {
    await db.collection('reports').doc(reportId).update({ status: 'resolved' });
    showToast('Rapor Ã§Ã¶zÃ¼ldÃ¼ olarak iÅŸaretlendi.', 'success');
    adminLoadReports();
